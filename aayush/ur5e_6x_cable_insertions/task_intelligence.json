{
  "tree": {
    "type": "sequence",
    "name": "Grasp, align-insert, release, and home",
    "children": [
      {
        "type": "action",
        "name": "Move to observation pose",
        "primitive": "navigate_to_workspace",
        "preconditions": ["robot_ready"],
        "success_conditions": ["at_workspace"]
      },
      {
        "type": "selector",
        "name": "Find grasp part on crystal head 45",
        "children": [
          {"type": "condition", "name": "Use cached detection", "fact": "target_visible"},
          {
            "type": "retry",
            "name": "Retry detection",
            "max_attempts": 3,
            "child": {
              "type": "action",
              "name": "Detect E_part006_44",
              "primitive": "perceive_objects",
              "success_conditions": ["target_visible"]
            }
          }
        ]
      },
      {
        "type": "selector",
        "name": "Acquire the cable",
        "children": [
          {"type": "condition", "name": "Cable already held", "fact": "cable_held"},
          {
            "type": "retry",
            "name": "Retry physical grasp",
            "max_attempts": 2,
            "child": {
              "type": "action",
              "name": "Grasp and lift E_part006_44",
              "primitive": "grasp_object",
              "preconditions": ["target_visible"],
              "success_conditions": ["cable_held"]
            }
          }
        ]
      },
      {"type": "condition", "name": "Confirm grasp after lift", "fact": "cable_held"},
      {
        "type": "selector",
        "name": "Maneuver to port offset",
        "children": [
          {"type": "condition", "name": "Already at port offset", "fact": "at_port_offset"},
          {
            "type": "action",
            "name": "Maneuver held cable to port offset",
            "primitive": "maneuver_to_port_offset",
            "preconditions": ["cable_held"],
            "success_conditions": ["at_port_offset"]
          }
        ]
      },
      {
        "type": "selector",
        "name": "Align and insert into port",
        "children": [
          {"type": "condition", "name": "Already inserted", "fact": "at_port_insert"},
          {
            "type": "action",
            "name": "Align and insert until mating planes touch",
            "primitive": "align_and_insert",
            "preconditions": ["cable_held", "at_port_offset"],
            "success_conditions": ["at_port_insert"]
          }
        ]
      },
      {
        "type": "action",
        "name": "Release cable after insert",
        "primitive": "release_gripper",
        "preconditions": ["at_port_insert"],
        "success_conditions": ["cable_released"]
      },
      {
        "type": "action",
        "name": "Return home",
        "primitive": "return_home",
        "preconditions": ["cable_released"],
        "success_conditions": ["at_home"]
      }
    ]
  }
}
