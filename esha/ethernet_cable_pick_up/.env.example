# Copy this file to .env and set it to this machine's actual Isaac Sim
# assets root. .env itself is gitignored — never commit real paths.
ISAACSIM_ASSETS_ROOT=/home/advaith/Isaacsim-assets

# Only needed if this machine nests the Data Hall asset under an extra
# folder layer. Defaults to ISAACSIM_ASSETS_ROOT if unset.
DATAHALL_ASSETS_ROOT=/home/advaith/Isaacsim-assets
